NODE_ENV=development
LOG_LEVEL=info

FRONTEND_PORT=3000
GATEWAY_PORT=4000
USER_SERVICE_PORT=4001
VEHICLE_SERVICE_PORT=4002
TELEMETRY_SERVICE_PORT=4003
GEOLOCATION_SERVICE_PORT=4004
NOTIFICATION_SERVICE_PORT=4005

USER_SERVICE_URL=http://localhost:4001
VEHICLE_SERVICE_URL=http://localhost:4002
TELEMETRY_SERVICE_URL=http://localhost:4003
GEOLOCATION_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005

MONGODB_URI=mongodb://localhost:27017
USER_DB_NAME=fleet_users
VEHICLE_DB_NAME=fleet_vehicles
TELEMETRY_DB_NAME=fleet_telemetry
GEOLOCATION_DB_NAME=fleet_geolocation
NOTIFICATION_DB_NAME=fleet_notifications

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12

API_KEYS=development-api-key
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
PROXY_TIMEOUT_MS=5000

GEOCODER_PROVIDER=mock
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fleet-administration-assignment/1.0
GEOCODER_TIMEOUT_MS=5000
MAX_NEARBY_RADIUS_KM=100

SMS_PROVIDER=stub
SMS_STUB_MODE=success
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

VITE_API_BASE_URL=http://localhost:4000
VITE_DEMO_API_KEY=development-api-key
