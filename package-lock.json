{
  "name": "fleet-administration",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fleet-administration",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22",
        "npm": ">=10"
      }
    },
    "apps/frontend": {
      "name": "@fleet/frontend",
      "version": "1.0.0"
    },
    "apps/gateway": {
      "name": "@fleet/gateway",
      "version": "1.0.0",
      "dependencies": {
        "@fleet/shared": "*"
      }
    },
    "apps/geolocation-service": {
      "name": "@fleet/geolocation-service",
      "version": "1.0.0",
      "dependencies": {
        "@fleet/shared": "*"
      }
    },
    "apps/notification-service": {
      "name": "@fleet/notification-service",
      "version": "1.0.0",
      "dependencies": {
        "@fleet/shared": "*"
      }
    },
    "apps/telemetry-service": {
      "name": "@fleet/telemetry-service",
      "version": "1.0.0",
      "dependencies": {
        "@fleet/shared": "*"
      }
    },
    "apps/user-service": {
      "name": "@fleet/user-service",
      "version": "1.0.0",
      "dependencies": {
        "@fleet/shared": "*"
      }
    },
    "apps/vehicle-service": {
      "name": "@fleet/vehicle-service",
      "version": "1.0.0",
      "dependencies": {
        "@fleet/shared": "*"
      }
    },
    "node_modules/@fleet/frontend": {
      "resolved": "apps/frontend",
      "link": true
    },
    "node_modules/@fleet/gateway": {
      "resolved": "apps/gateway",
      "link": true
    },
    "node_modules/@fleet/geolocation-service": {
      "resolved": "apps/geolocation-service",
      "link": true
    },
    "node_modules/@fleet/notification-service": {
      "resolved": "apps/notification-service",
      "link": true
    },
    "node_modules/@fleet/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@fleet/telemetry-service": {
      "resolved": "apps/telemetry-service",
      "link": true
    },
    "node_modules/@fleet/user-service": {
      "resolved": "apps/user-service",
      "link": true
    },
    "node_modules/@fleet/vehicle-service": {
      "resolved": "apps/vehicle-service",
      "link": true
    },
    "node_modules/dotenv": {
      "version": "18.0.9",
      "resolved": "https://registry.npmjs.org/dotenv/-/dotenv-18.0.9.tgz",
      "integrity": "sha512-3fVOW4cB02R066PUSwn8O4TJyz9NckQl7F81blIbaq9jKBm2tSmOKky7ZHIXzGvkVPXCSn6jkpziBPZdGFs8Tw==",
      "license": "BSD-2-Clause",
      "bin": {
        "dotenv": "dist/index.cjs"
      },
      "engines": {
        "node": ">=12"
      },
      "funding": {
        "url": "https://dotenvx.com"
      }
    },
    "node_modules/zod": {
      "version": "4.6.7",
      "resolved": "https://registry.npmjs.org/zod/-/zod-4.6.7.tgz",
      "integrity": "sha512-g8W2D2kU6a8untc053fX1uVBKzM7yqAxW/3zwk83+6RyF2+SKOuV+c0wBDhUwzV1PaGapmZH+rmcUzPf+3CGwg==",
      "license": "MIT",
      "funding": {
        "url": "https://github.com/sponsors/colinhacks"
      }
    },
    "packages/shared": {
      "name": "@fleet/shared",
      "version": "1.0.0",
      "dependencies": {
        "dotenv": "^18.0.9",
        "zod": "^4.6.7"
      }
    }
