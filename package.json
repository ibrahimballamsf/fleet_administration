{
  "name": "fleet-administration",
  "version": "1.0.0",
  "private": true,
  "description": "Fleet Administration BITS Pilani assignment",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d mongodb",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mongodb",
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "docs:validate": "npm run docs:validate --workspace=@fleet/gateway --if-present",
    "seed": "npm run seed --workspace=@fleet/vehicle-service --if-present"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "license": "ISC"
}
